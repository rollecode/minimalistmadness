{
  "name": "minimalistmadness",
  "version": "5.0.7",
  "description": "A minimalist WordPress starter theme.",
  "author": "Digitoimisto Dude Oy (moro@dude.fi)",
  "scripts": {
    "css": "npm run css:dev && npm run css:prod",
    "css:dev": "sass --load-path=sass --load-path=node_modules --style=expanded --no-source-map sass:css/dev",
    "css:prod": "sass --load-path=sass --load-path=node_modules --style=compressed --no-source-map sass:css/prod",
    "watch": "npm run css:dev -- --watch"
  },
  "devDependencies": {
    "magic.css": "^1.4.8",
    "sanitize.css": "git+https://github.com/csstools/sanitize.css.git",
    "sass": "^1.69.4"
  }
}
